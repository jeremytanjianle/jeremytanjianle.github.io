---
import { getCollection } from 'astro:content';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const aiProjects = projects.filter((project) => project.data.category === 'ai');
const financeProjects = projects.filter((project) => project.data.category === 'finance');
---
<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero-shell">
				<Hero
					title={`AI Automation for Business
& Quantitative Trading`}
					tagline={`Hi, I’m Jeremy.
I build high-impact business automations—from news monitoring and intelligence to rapid query response and CRM integrations.
I also develop self-maintaining trading systems with a strong live track record.`}
					align="start"
				/>
				<img alt="Jeremy Tan" width="480" height="620" src="/img/1st%20dp.jpg" />
			</header>
		</div>

		<main class="wrapper stack gap-20 lg:gap-30">
			<section class="section">
				<header class="section-header"><div><h2><span class="section-number">01 ·</span> AI & Automations</h2><p class="section-summary">Tirelessly supporting real businesses.</p></div><a href="/ai-automations/">View AI work <span aria-hidden="true">→</span></a></header>
				<Grid>{aiProjects.map((project) => <li><PortfolioPreview project={project} /></li>)}</Grid>
			</section>
			<section class="section">
				<header class="section-header"><div><h2><span class="section-number">02 ·</span> Finance</h2><p class="section-summary">Research to live systems</p></div><a href="/finance/">View finance work <span aria-hidden="true">→</span></a></header>
				<Grid>{financeProjects.map((project) => <li><PortfolioPreview project={project} /></li>)}</Grid>
			</section>
		</main>
	</div>
</BaseLayout>
<style>
	.hero-shell { display: flex; flex-direction: column; align-items: center; gap: 2rem; }
	.hero-shell img { width: 100%; max-height: 28rem; aspect-ratio: 5 / 4; object-fit: cover; object-position: center 25%; border: 1px solid var(--gray-800); border-radius: .25rem; filter: grayscale(.08) saturate(.75); }
	.section { display: grid; gap: 2.5rem; }
	.section-header { display: flex; flex-direction: column; gap: 1rem; }
	.section-header h2 { font-size: var(--text-2xl); color: var(--gray-0); }
	.section-number { color: var(--accent-dark); font-size: .42em; font-weight: 700; letter-spacing: .08em; vertical-align: .45em; }
	.section-summary { margin-top: .6rem; color: var(--gray-300); font-size: var(--text-base); line-height: 1.5; }
	.section-header > a { align-self: flex-start; color: var(--gray-200); text-underline-offset: .25em; }
	@media (min-width: 50em) {
		.hero-shell { display: grid; grid-template-columns: 6fr 4fr; gap: 3.75rem; padding-inline: 2.5rem; }
		.hero-shell img { max-height: none; aspect-ratio: 3 / 4; }
		.section-header { flex-direction: row; justify-content: space-between; align-items: end; }
		.section-header h2 { font-size: var(--text-3xl); }
		.section-summary { font-size: var(--text-md); }
		.section-header > a { align-self: auto; margin-bottom: .45rem; }
	}
</style>
