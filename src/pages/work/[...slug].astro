---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';

import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props { entry: CollectionEntry<'work'>; }
export async function getStaticPaths() {
	return (await getCollection('work')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.title} · Jeremy Tan`} description={entry.data.description}>
	<div class="stack gap-20">
		<div class="stack gap-15">
			<header><div class="wrapper stack gap-2"><a class="back-link" href="/"><Icon icon="arrow-left" /> All projects</a><Hero title={entry.data.title} align="start"><p class="description">{entry.data.description}</p></Hero></div></header>
			<main class="wrapper"><article class="stack gap-10 content">{entry.data.img && <img class="cover" src={entry.data.img} alt={entry.data.img_alt || ''} />}<div class="prose"><Content /></div></article></main>
		</div>
	</div>
</BaseLayout>
<style>
	header { padding-bottom: 2.5rem; border-bottom: 1px solid var(--gray-800); }
	.back-link { display: inline-flex; align-items: center; gap: .35rem; align-self: flex-start; color: var(--gray-300); text-decoration: none; }
	.description { max-width: 58ch; color: var(--gray-300); font-size: var(--text-lg); }
	.content { max-width: 68rem; margin-inline: auto; }
	.cover { width: 100%; max-height: 38rem; object-fit: contain; border: 1px solid var(--gray-800); border-radius: .25rem; background: var(--gray-900); }
	.prose { max-width: 68ch; margin-inline: auto; color: var(--gray-200); font-size: var(--text-md); }
	.prose :global(* + *) { margin-top: 1rem; }
	.prose :global(h2), .prose :global(h3) { margin-top: 2.5rem; }
	.prose :global(h2) { font-size: var(--text-2xl); }
	.prose :global(h3) { font-size: var(--text-xl); }
	.prose :global(img) { width: 100%; margin-block: 1.5rem; border: 1px solid var(--gray-800); border-radius: .25rem; }
	.prose :global(.diagram) { width: min(68rem, calc(100vw - 2rem)); margin: 2.5rem 50% 0; transform: translateX(-50%); }
	.prose :global(.diagram img) { display: block; margin: 0; background: #fff; }
	.prose :global(.diagram figcaption) { max-width: 68ch; margin: .75rem auto 0; color: var(--gray-400); font-size: var(--text-sm); text-align: center; }
	.prose :global(a) { text-underline-offset: .25em; }
	.prose :global(blockquote) { padding-left: 1.25rem; border-left: .2rem solid var(--accent-regular); color: var(--gray-0); font-family: var(--font-brand); font-size: var(--text-xl); }
</style>
