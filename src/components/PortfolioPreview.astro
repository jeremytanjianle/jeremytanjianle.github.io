---
import type { CollectionEntry } from 'astro:content';
const { data, id } = Astro.props.project as CollectionEntry<'work'>;
const categoryLabel = data.category === 'ai' ? 'AI & Automations' : 'Finance';
---

<a class="card" href={`/work/${id}/`}>
	<div class="visual" class:list={{ abstract: !data.img }}>
		{data.img ? <img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" /> : (
			<>
				<span class="signal" aria-hidden="true"></span>
				<span class="monogram" aria-hidden="true">{id === 'adgen-workspace' ? 'AG' : 'HF'}</span>
			</>
		)}
	</div>
	<div class="meta">
		<div class="eyebrow"><span>{categoryLabel}</span>{data.status && <span class="status">{data.status}</span>}</div>
		<h3>{data.title}</h3>
		<p>{data.description}</p>
	</div>
</a>

<style>
	.card { display: flex; flex-direction: column; height: 100%; overflow: hidden; border: 1px solid var(--gray-800); border-radius: .25rem; background: var(--gray-999); text-decoration: none; transition: border-color .15s ease; }
	.card:hover, .card:focus { border-color: var(--accent-regular); }
	.visual { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--gray-900); border-bottom: 1px solid var(--gray-800); }
	.visual img { width: 100%; height: 100%; object-fit: cover; }
	.abstract { display: grid; place-items: center; background: var(--gray-900); }
	.signal { position: absolute; inset: 16%; border: 1px solid var(--gray-700); }
	.monogram { position: relative; font-family: var(--font-brand); font-size: clamp(3rem, 8vw, 5rem); font-weight: 600; color: var(--accent-regular); letter-spacing: -.08em; }
	.meta { display: flex; flex: 1; flex-direction: column; gap: .65rem; padding: 1.25rem; }
	.eyebrow { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--gray-400); font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.status { color: var(--accent-dark); }
	h3 { font-size: var(--text-xl); color: var(--gray-0); }
	p { color: var(--gray-300); }
</style>
