---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

---

<nav aria-label="Primary navigation">
	<div>
		<a href="/" class="site-title">
			<span class="mark" aria-hidden="true">JT</span>
			<span>Jeremy Tan</span>
		</a>
	</div>
	<div class="menu-footer">
		<a class="social" href="https://github.com/jeremytanjianle" aria-label="GitHub"><Icon icon="github-logo" /></a>
		<a class="social linkedin" href="https://www.linkedin.com/in/jeremy-tan-jian-le/">in</a>
		<ThemeToggle />
	</div>
</nav>

<style>
	nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 3.5rem; padding: 1.25rem 1.5rem; font-family: var(--font-brand); }
	.site-title { display: flex; align-items: center; gap: .65rem; color: var(--gray-0); text-decoration: none; font-weight: 600; }
	.mark { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--gray-700); border-radius: .2rem; color: var(--gray-0); font-size: .72rem; letter-spacing: .06em; }
	.menu-footer { display: flex; align-items: center; gap: .25rem; }
	.social { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; color: var(--gray-300); text-decoration: none; }
	.linkedin { font-weight: 700; font-family: Arial, sans-serif; }

	@media (min-width: 56em) {
		nav { padding: 2rem 5rem; }
	}
</style>
