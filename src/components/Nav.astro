---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const groups = [
	{
		label: 'AI & Automations',
		href: '/ai-automations/',
		items: [
			{ label: 'AdGen Workspace', href: '/work/adgen-workspace/' },
		],
	},
	{
		label: 'Finance',
		href: '/finance/',
		items: [
			{ label: 'Self-driving Hedge Fund', href: '/work/self-driving-hedge-fund/' },
			{ label: 'Live Trading', href: '/work/live-trading/' },
			{ label: 'Trademate', href: '/work/trademate/' },
			{ label: 'Stock Historian', href: '/work/stock-historian/' },
		],
	},
];

const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const pathname = normalize(Astro.url.pathname.replace(import.meta.env.BASE_URL, '') || '/');
const isCurrent = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));
---

<nav aria-label="Primary navigation">
	<div class="menu-header">
		<a href="/" class="site-title">
			<span class="mark" aria-hidden="true">JT</span>
			<span>Jeremy Tan</span>
		</a>
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false" aria-controls="menu-content">
					<span class="sr-only">Toggle menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>

	<div id="menu-content" class="menu-content">
		<ul class="nav-items">
			<li><a aria-current={pathname === '/' ? 'page' : undefined} class="link" href="/">Hi There</a></li>
			{groups.map((group) => (
				<li class="nav-group">
					<a aria-current={isCurrent(group.href) ? 'page' : undefined} class="link group-link" href={group.href}>
						{group.label}<span aria-hidden="true" class="chevron">⌄</span>
					</a>
					<ul class="submenu">
						{group.items.map((item) => (
							<li><a aria-current={isCurrent(item.href) ? 'page' : undefined} href={item.href}>{item.label}</a></li>
						))}
					</ul>
				</li>
			))}
		</ul>

		<div class="menu-footer">
			<a class="social" href="https://github.com/jeremytanjianle" aria-label="GitHub">
				<Icon icon="github-logo" />
			</a>
			<a class="social linkedin" href="https://www.linkedin.com/in/jeremy-tan-jian-le/">in</a>
			<ThemeToggle />
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const button = this.querySelector('button')!;
			const menu = document.getElementById('menu-content')!;
			const setExpanded = (expanded: boolean) => {
				button.setAttribute('aria-expanded', String(expanded));
				menu.classList.toggle('is-open', expanded);
			};
			button.addEventListener('click', () => setExpanded(!menu.classList.contains('is-open')));
			const desktop = window.matchMedia('(min-width: 56em)');
			const sync = () => {
				if (desktop.matches) setExpanded(false);
				button.hidden = desktop.matches;
			};
			sync();
			desktop.addEventListener('change', sync);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav { position: relative; z-index: 20; margin-bottom: 3.5rem; font-family: var(--font-brand); }
	.menu-header { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; }
	.site-title { display: flex; align-items: center; gap: .65rem; color: var(--gray-0); text-decoration: none; font-weight: 600; }
	.mark { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--gray-700); border-radius: .2rem; color: var(--gray-0); font-size: .72rem; letter-spacing: .06em; }
	.menu-button { display: flex; border: 1px solid var(--gray-700); border-radius: .2rem; padding: .55rem; color: var(--gray-200); background: var(--gray-999); font-size: 1.3rem; }
	.menu-button[hidden] { display: none; }
	.menu-content { display: none; position: absolute; inset-inline: 0; padding: 0 1rem 1rem; background: var(--gray-999); border-bottom: 1px solid var(--gray-800); }
	.menu-content.is-open { display: block; }
	.nav-items, .submenu { list-style: none; padding: 0; margin: 0; }
	.nav-items { display: flex; flex-direction: column; gap: .25rem; }
	.link, .submenu a { display: block; color: var(--gray-300); text-decoration: none; }
	.link { padding: .75rem; font-weight: 500; }
	.link:hover, .link:focus, .submenu a:hover, .submenu a:focus { color: var(--accent-dark); }
	.link[aria-current], .submenu a[aria-current] { color: var(--accent-dark); }
	.chevron { margin-left: .35rem; color: var(--gray-400); }
	.submenu { margin: 0 0 .5rem 1rem; padding-left: .75rem; border-left: 1px solid var(--gray-800); }
	.submenu a { padding: .55rem .75rem; font-size: var(--text-sm); }
	.menu-footer { display: flex; align-items: center; gap: .25rem; margin-top: .75rem; padding-top: .75rem; border-top: 1px solid var(--gray-800); }
	.social { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; color: var(--gray-300); text-decoration: none; }
	.linkedin { font-weight: 700; font-family: Arial, sans-serif; }

	@media (min-width: 56em) {
		nav { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 2rem 5rem; }
		.menu-header { padding: 0; }
		.menu-content { display: contents; }
		.nav-items { flex-direction: row; gap: .25rem; }
		.link { padding: .55rem .8rem; border-bottom: 1px solid transparent; font-size: var(--text-sm); }
		.link[aria-current='page'] { color: var(--gray-0); border-bottom-color: var(--accent-regular); }
		.nav-group { position: relative; }
		.submenu { visibility: hidden; opacity: 0; position: absolute; top: calc(100% + .65rem); left: 50%; min-width: 15rem; margin: 0; padding: .5rem; transform: translate(-50%, -.25rem); border: 1px solid var(--gray-700); border-radius: .2rem; background: var(--gray-999); transition: opacity .15s ease, transform .15s ease, visibility .15s; }
		.nav-group:hover .submenu, .nav-group:focus-within .submenu { visibility: visible; opacity: 1; transform: translate(-50%, 0); }
		.submenu a { padding: .7rem .8rem; }
		.menu-footer { justify-self: end; margin: 0; padding: 0; border: 0; }
	}
</style>
