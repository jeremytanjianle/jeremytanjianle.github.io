---
const currentYear = new Date().getFullYear();
---
<footer>
	<p>&copy; {currentYear} Jeremy Tan Jianle</p>
	<p class="socials"><a href="https://github.com/jeremytanjianle">GitHub</a><a href="https://www.linkedin.com/in/jeremy-tan-jian-le/">LinkedIn</a></p>
</footer>
<style>
	footer { display: flex; flex-direction: column; gap: 1rem; margin-top: auto; padding: 3rem 1.5rem; border-top: 1px solid var(--gray-800); color: var(--gray-400); font-size: var(--text-sm); text-align: center; }
	footer a { color: var(--gray-300); text-underline-offset: .25em; }
	.socials { display: flex; justify-content: center; gap: 1rem; }
	@media (min-width: 50em) { footer { flex-direction: row; justify-content: space-between; padding: 2.5rem 5rem; text-align: left; } }
</style>
