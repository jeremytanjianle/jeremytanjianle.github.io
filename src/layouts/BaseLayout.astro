---
import Footer from '../components/Footer.astro';
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
const { title, description } = Astro.props;
---
<html lang="en">
	<head><MainHead title={title} description={description} /></head>
	<body>
		<div class="stack backgrounds">
			<Nav />
			<slot />
			<Footer />
		</div>
	</body>
</html>
<style>
	.backgrounds { min-height: 100vh; isolation: isolate; background: var(--gray-999); }
	@media (forced-colors: active) { .backgrounds { background: none; } }
</style>
